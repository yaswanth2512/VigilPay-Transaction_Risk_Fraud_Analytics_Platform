    user_id,
    ROUND(user_avg_amount, 2) AS user_avg_amount,
    COALESCE(ROUND(user_std_amount, 2), 0.0) AS user_std_amount,
    ROUND(user_max_amount, 2) AS user_max_amount,
    user_total_txns,
    user_primary_device,
    user_usual_hour
FROM user_baselines
  );

